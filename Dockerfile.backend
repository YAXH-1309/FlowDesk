# ── Build stage ──────────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .
COPY core core
COPY auth auth
COPY task task
COPY hr hr
COPY inventory inventory
COPY accounting accounting
COPY sales sales
COPY reporting reporting

RUN chmod +x gradlew && ./gradlew :auth:bootJar --no-daemon -q

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S flowdesk && adduser -S flowdesk -G flowdesk
USER flowdesk

COPY --from=build /workspace/auth/build/libs/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
